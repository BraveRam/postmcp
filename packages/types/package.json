{
  "name": "@postmcp/types",
  "version": "0.1.25",
  "description": "Unified TypeScript types and interfaces for the PostMCP ecosystem",
  "license": "MIT",
  "author": "PostMCP Contributors",
  "homepage": "https://postmcp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraveRam/postmcp.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/BraveRam/postmcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "axios": "^1.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postmcp",
    "typescript-types",
    "type-definitions",
    "openapi",
    "interfaces"
  ]
}
