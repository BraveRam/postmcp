{
  "name": "@postmcp/types",
  "version": "0.1.0",
  "description": "Unified TypeScript types and interfaces for the PostMCP ecosystem",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "axios": "^1.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
