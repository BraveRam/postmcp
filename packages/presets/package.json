{
  "name": "@postmcp/presets",
  "version": "0.1.26",
  "description": "60+ Curated, context-optimized API presets for PostMCP",
  "license": "MIT",
  "author": "PostMCP Contributors",
  "homepage": "https://postmcp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraveRam/postmcp.git",
    "directory": "packages/presets"
  },
  "bugs": {
    "url": "https://github.com/BraveRam/postmcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@postmcp/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postmcp",
    "openapi",
    "api-presets",
    "stripe",
    "github",
    "slack",
    "supabase",
    "twilio",
    "openai",
    "ai-agents"
  ]
}
