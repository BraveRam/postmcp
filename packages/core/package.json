{
  "name": "@postmcp/core",
  "version": "0.1.4",
  "description": "PostMCP core engine - OpenAPI parser, Token Diet, JIT router, and MCP protocol server",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@postmcp/types": "^0.1.4",
    "@types/dotenv": "^8.2.3",
    "axios": "^1.7.9",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "jsonpath-plus": "^10.3.0",
    "mime-types": "^3.0.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postmcp",
    "openapi",
    "swagger",
    "mcp-server",
    "token-diet",
    "jit-router",
    "ai-agents",
    "llm",
    "json-schema",
    "rest-api",
    "token-optimization",
    "api-gateway"
  ]
}
